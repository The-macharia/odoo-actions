# Written by the observer action and pulled into the Odoo server{} by
#   include /etc/nginx/conf.d/monitor/*.locations;
# ^~ keeps the static-asset regex locations from taking these paths. Upstreams are resolved per
# request so nginx still starts while the observer stack is down.

location = /monitor { return 301 /monitor/; }

location ^~ /monitor/ {
    resolver 127.0.0.11 valid=30s;
    set $observer_grafana observer_grafana:3000;
    proxy_pass http://$observer_grafana;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $http_connection;
}

# Read-only APIs the hub queries, behind the fleet password. Prometheus runs without the admin
# and lifecycle APIs; Loki only exposes its query endpoints here.
location ^~ /monitor/prometheus/ {
    auth_basic observer;
    auth_basic_user_file /etc/nginx/conf.d/monitor/htpasswd;
    limit_except GET POST { deny all; }
    resolver 127.0.0.11 valid=30s;
    set $observer_prometheus observer_prometheus:9090;
    rewrite ^/monitor/prometheus/(.*)$ /$1 break;
    proxy_pass http://$observer_prometheus;
}

location ^~ /monitor/loki/ {
    auth_basic observer;
    auth_basic_user_file /etc/nginx/conf.d/monitor/htpasswd;
    resolver 127.0.0.11 valid=30s;

    location ~ ^/monitor/loki/(loki/api/v1/(query|query_range|labels|label/[^/]+/values|series|index/stats|index/volume|index/volume_range|detected_labels|detected_fields|patterns|format_query|status/buildinfo)|ready)$ {
        set $observer_loki observer_loki:3100;
        rewrite ^/monitor/loki/(.*)$ /$1 break;
        proxy_pass http://$observer_loki;
    }
    return 403;
}
