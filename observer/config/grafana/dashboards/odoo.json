{
  "uid": "odoo",
  "title": "Odoo",
  "description": "Built from Odoo's own log lines: '<date> <time> <pid> <level> <db> <logger>: <message> <sql queries> <sql time> <other time>'.",
  "tags": ["observer"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "links": [{"title": "Dashboards", "type": "dashboards", "tags": ["observer"], "asDropdown": true, "includeVars": true, "keepTime": true}],
  "templating": {"list": [
    {"name": "ds", "label": "Server", "type": "datasource", "query": "prometheus", "current": {"text": "__CLIENT__", "value": "prometheus"}},
    {"name": "logs", "label": "Logs", "type": "datasource", "query": "loki", "regex": "/^${ds:text} logs$/", "hide": 2},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "loki", "uid": "${logs}"},
     "query": {"type": 1, "label": "service", "refId": "service"}, "regex": "/.+_(odoo|website|odoo15)$/",
     "refresh": 2, "multi": true, "includeAll": true, "allValue": ".+_(odoo|website|odoo15)", "current": {"text": "All", "value": "$__all"}},
    {"name": "pid", "label": "Odoo pid (regex)", "type": "textbox", "query": ".+", "current": {"text": ".+", "value": ".+"}},
    {"name": "level", "label": "Level", "type": "custom", "query": "INFO,WARNING,ERROR,CRITICAL",
     "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"type": "timeseries", "title": "Requests per minute by status", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "interval": "1m",
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "legendFormat": "{{status}}",
       "expr": "sum by (status) (count_over_time({service=~\"$service\"} |= `werkzeug` != `/websocket` | regexp `HTTP/[0-9.]+\" (?P<status>\\d{3}) ` [1m]))"}],
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 30}}, "overrides": []}},
    {"type": "timeseries", "title": "Request time (SQL + Python)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "interval": "1m",
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [
       {"refId": "A", "legendFormat": "p95 {{service}}",
        "expr": "quantile_over_time(0.95, {service=~\"$service\"} |= `werkzeug` != `/websocket` | regexp `\" \\d{3} \\S+ (?P<queries>\\d+) (?P<qtime>[\\d.]+) (?P<rtime>[\\d.]+)` | label_format total=`{{ addf .qtime .rtime }}` | unwrap total | __error__=\"\" [$__interval]) by (service)"},
       {"refId": "B", "legendFormat": "p50 {{service}}",
        "expr": "quantile_over_time(0.5, {service=~\"$service\"} |= `werkzeug` != `/websocket` | regexp `\" \\d{3} \\S+ (?P<queries>\\d+) (?P<qtime>[\\d.]+) (?P<rtime>[\\d.]+)` | label_format total=`{{ addf .qtime .rtime }}` | unwrap total | __error__=\"\" [$__interval]) by (service)"}],
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},

    {"type": "logs", "title": "Requests slower than 3s (the number after the pid is the worker)", "gridPos": {"x": 0, "y": 8, "w": 24, "h": 9},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A",
       "expr": "{service=~\"$service\"} |= `werkzeug` != `/websocket` | regexp `\" \\d{3} \\S+ (?P<queries>\\d+) (?P<qtime>[\\d.]+) (?P<rtime>[\\d.]+)` | label_format total=`{{ addf .qtime .rtime }}` | __error__=\"\" | total > 3"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}},

    {"type": "timeseries", "title": "SQL queries per request (p95)", "gridPos": {"x": 0, "y": 17, "w": 12, "h": 8}, "interval": "1m",
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "legendFormat": "{{service}}",
       "expr": "quantile_over_time(0.95, {service=~\"$service\"} |= `werkzeug` != `/websocket` | regexp `\" \\d{3} \\S+ (?P<queries>\\d+) [\\d.]+ [\\d.]+` | unwrap queries | __error__=\"\" [$__interval]) by (service)"}],
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"type": "timeseries", "title": "Errors per minute by module", "gridPos": {"x": 12, "y": 17, "w": 12, "h": 8}, "interval": "1m",
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "legendFormat": "{{logger}}",
       "expr": "sum by (logger) (count_over_time({service=~\"$service\", level=~\"ERROR|CRITICAL\"} | regexp `^\\S+ \\S+ \\d+ \\S+ \\S+ (?P<logger>[^:]+):` [1m]))"}],
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}}}, "overrides": []}},

    {"type": "timeseries", "title": "Worker lifecycle", "description": "Killed: SIGKILL after limit_time_real, its open Postgres sessions can linger. Recycled: graceful restart after limit_memory_soft or limit_request.", "gridPos": {"x": 0, "y": 25, "w": 12, "h": 8},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [
       {"refId": "A", "legendFormat": "killed (time limit)", "expr": "sum(count_over_time({service=~\"$service\"} |~ `\\(\\d+\\) timeout after \\d+s` [$__interval]))"},
       {"refId": "B", "legendFormat": "CPU time limit", "expr": "sum(count_over_time({service=~\"$service\"} |= `CPU time limit` [$__interval]))"},
       {"refId": "C", "legendFormat": "recycled (memory)", "expr": "sum(count_over_time({service=~\"$service\"} |= `virtual memory limit` [$__interval]))"},
       {"refId": "D", "legendFormat": "recycled (requests)", "expr": "sum(count_over_time({service=~\"$service\"} |= `max request` [$__interval]))"},
       {"refId": "E", "legendFormat": "started", "expr": "sum(count_over_time({service=~\"$service\"} |~ `Worker \\w+ \\(\\d+\\) alive` [$__interval]))"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "custom": {"drawStyle": "bars"}}, "overrides": [
       {"matcher": {"id": "byName", "options": "killed (time limit)"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]}},
    {"type": "timeseries", "title": "Cron job duration", "gridPos": {"x": 12, "y": 25, "w": 12, "h": 8},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "legendFormat": "{{job}}",
       "expr": "max by (job) (max_over_time({service=~\"$service\"} |= `ir_cron` |= `done in` | regexp `Job '(?P<job>[^']+)' \\(\\d+\\) done in (?P<secs>[\\d.]+)s` | unwrap secs | __error__=\"\" [$__interval]))"}],
     "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "points", "pointSize": 6}}, "overrides": []}},

    {"type": "logs", "title": "Cron runs", "gridPos": {"x": 0, "y": 33, "w": 24, "h": 9},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "{service=~\"$service\"} |= `ir_cron` |~ `Job .+ \\(\\d+\\) (starting|done in|timed out|completed)`"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"type": "logs", "title": "Odoo log (filter by pid and level above)", "gridPos": {"x": 0, "y": 42, "w": 24, "h": 16},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "{service=~\"$service\", level=~\"$level\"} | regexp `^\\S+ \\S+ (?P<pid>\\d+) ` | pid=~\"$pid\""}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true}}
  ]
}
