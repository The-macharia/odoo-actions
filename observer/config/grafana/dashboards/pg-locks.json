{
  "uid": "pg-locks",
  "title": "Locks & deadlocks",
  "description": "History of lock waits and deadlocks. The live blocking chain is on Postgres live, on the server's own /monitor.",
  "tags": ["observer"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "links": [{"title": "Dashboards", "type": "dashboards", "tags": ["observer"], "asDropdown": true, "includeVars": true, "keepTime": true}],
  "templating": {"list": [
    {"name": "ds", "label": "Server", "type": "datasource", "query": "prometheus", "current": {"text": "__CLIENT__", "value": "prometheus"}},
    {"name": "logs", "label": "Logs", "type": "datasource", "query": "loki", "regex": "/^${ds:text} logs$/", "hide": 2}
  ]},
  "panels": [
    {"type": "stat", "title": "Blocked sessions now", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "pg_blocked_sessions"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Longest lock wait now", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "pg_blocked_max_wait_seconds"}],
     "fieldConfig": {"defaults": {"unit": "s", "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 30}, {"color": "red", "value": 120}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Deadlocks (range)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(increase(pg_stat_database_deadlocks[$__range]))", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Lock waits over 1s (range)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "sum(count_over_time({service=~\".+_db\"} |= `still waiting for` [$__range])) or vector(0)", "queryType": "instant"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"type": "timeseries", "title": "Blocked sessions and longest wait", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "pg_blocked_sessions", "legendFormat": "blocked sessions"},
                 {"refId": "B", "expr": "pg_blocked_max_wait_seconds", "legendFormat": "longest wait"}],
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [
       {"matcher": {"id": "byName", "options": "longest wait"}, "properties": [{"id": "unit", "value": "s"}, {"id": "custom.axisPlacement", "value": "right"}]}]}},
    {"type": "timeseries", "title": "Deadlocks", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum by (datname) (increase(pg_stat_database_deadlocks[$__rate_interval])) > 0", "legendFormat": "{{datname}}"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "custom": {"drawStyle": "bars"}}, "overrides": []}},
    {"type": "timeseries", "title": "Locks held by mode", "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum by (mode) (pg_locks_count) > 0", "legendFormat": "{{mode}}"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []}},

    {"type": "logs", "title": "Deadlock reports: the ERROR line names the aborted process (app=), DETAIL lists every process and its statement", "gridPos": {"x": 0, "y": 20, "w": 24, "h": 12},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "{service=~\".+_db\"} |~ `deadlock detected|blocked by process`"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"type": "logs", "title": "Lock waits over 1s (log_lock_waits)", "gridPos": {"x": 0, "y": 32, "w": 24, "h": 10},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "{service=~\".+_db\"} |~ `still waiting for|acquired .+ after|Process holding the lock`"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"type": "logs", "title": "Postgres errors", "gridPos": {"x": 0, "y": 42, "w": 24, "h": 10},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "{service=~\".+_db\", level=~\"ERROR|FATAL|PANIC\"}"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}}
  ]
}
