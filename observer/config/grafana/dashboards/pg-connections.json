{
  "uid": "pg-connections",
  "title": "Postgres connections",
  "description": "Who holds the connections. A holder is application_name without its pid: Odoo processes are <service>.<slot> (or odoo), the opid column is the Odoo worker pid printed on its log lines.",
  "tags": ["observer"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "links": [{"title": "Dashboards", "type": "dashboards", "tags": ["observer"], "asDropdown": true, "includeVars": true, "keepTime": true}],
  "templating": {"list": [
    {"name": "ds", "label": "Server", "type": "datasource", "query": "prometheus", "current": {"text": "__CLIENT__", "value": "prometheus"}},
    {"name": "logs", "label": "Logs", "type": "datasource", "query": "loki", "regex": "/^${ds:text} logs$/", "hide": 2},
    {"name": "holder", "label": "Holder", "type": "query", "datasource": {"type": "prometheus", "uid": "${ds}"},
     "query": {"query": "label_values(pg_holder_connections, holder)", "refId": "holder"}, "definition": "label_values(pg_holder_connections, holder)",
     "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"type": "gauge", "title": "Usable connections taken", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 5},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "observer:pg_connections:ratio"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Open / usable", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 5},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(pg_holder_connections{usename!=\"observer\"})", "legendFormat": "open"},
                 {"refId": "B", "expr": "observer:pg_connections_usable", "legendFormat": "usable"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
     "options": {"colorMode": "none", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Idle in transaction", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 5},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(pg_holder_connections{state=~\"idle in transaction.*\"}) or vector(0)"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Oldest open transaction", "gridPos": {"x": 12, "y": 0, "w": 4, "h": 5},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "max(pg_holder_max_xact_seconds{usename!=\"observer\"})"}],
     "fieldConfig": {"defaults": {"unit": "s", "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 300}, {"color": "red", "value": 900}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Blocked sessions", "gridPos": {"x": 16, "y": 0, "w": 4, "h": 5},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "pg_blocked_sessions"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0,
       "links": [{"title": "Locks & deadlocks", "url": "/d/pg-locks?${__url_time_range}&var-ds=${ds}"}],
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Refused or pool-full (range)", "gridPos": {"x": 20, "y": 0, "w": 4, "h": 5},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "sum(count_over_time({service=~\".+_(odoo|website|odoo15|db)\"} |~ `too many clients|remaining connection slots|The Connection Pool Is Full` [$__range])) or vector(0)", "queryType": "instant"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"type": "table", "title": "Holders at the end of the range (click a pid for its Odoo log)", "gridPos": {"x": 0, "y": 5, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [
       {"refId": "A", "expr": "sum by (holder, opid, state, usename, client) (pg_holder_connections{holder=~\"$holder\"})", "instant": true, "format": "table"},
       {"refId": "B", "expr": "max by (holder, opid, state, usename, client) (pg_holder_max_xact_seconds{holder=~\"$holder\"})", "instant": true, "format": "table"}],
     "transformations": [
       {"id": "merge", "options": {}},
       {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"Value #A": "connections", "Value #B": "oldest transaction"}}},
       {"id": "sortBy", "options": {"sort": [{"field": "connections", "desc": true}]}}],
     "fieldConfig": {"defaults": {}, "overrides": [
       {"matcher": {"id": "byName", "options": "oldest transaction"}, "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 0}]},
       {"matcher": {"id": "byName", "options": "opid"}, "properties": [{"id": "links", "value": [
         {"title": "Odoo log for this pid", "url": "/d/odoo?${__url_time_range}&var-ds=${ds}&var-pid=${__value.raw}"}]}]}]},
     "options": {"showHeader": true, "footer": {"show": false}}},

    {"type": "timeseries", "title": "Connections by holder", "gridPos": {"x": 0, "y": 13, "w": 12, "h": 9},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum by (holder) (pg_holder_connections{holder=~\"$holder\"})", "legendFormat": "{{holder}}"},
                 {"refId": "B", "expr": "observer:pg_connections_usable", "legendFormat": "usable"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 30}}, "overrides": [
       {"matcher": {"id": "byName", "options": "usable"}, "properties": [
         {"id": "custom.stacking", "value": {"mode": "none"}}, {"id": "custom.fillOpacity", "value": 0},
         {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]}},
    {"type": "timeseries", "title": "Connections by Odoo process", "gridPos": {"x": 12, "y": 13, "w": 12, "h": 9},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum by (holder, opid) (pg_holder_connections{holder=~\"$holder\", opid!=\"\"})", "legendFormat": "{{holder}}-{{opid}}"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 30},
       "links": [{"title": "Odoo log for ${__field.labels.opid}", "url": "/d/odoo?${__url_time_range}&var-ds=${ds}&var-pid=${__field.labels.opid}"}]}, "overrides": []}},

    {"type": "timeseries", "title": "Connections by state", "gridPos": {"x": 0, "y": 22, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum by (state) (pg_holder_connections{holder=~\"$holder\"})", "legendFormat": "{{state}}"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 30}}, "overrides": []}},
    {"type": "timeseries", "title": "Connections by client address", "gridPos": {"x": 8, "y": 22, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum by (client) (pg_holder_connections{holder=~\"$holder\"})", "legendFormat": "{{client}}"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 30}}, "overrides": []}},
    {"type": "timeseries", "title": "Oldest open transaction by process", "gridPos": {"x": 16, "y": 22, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "topk(10, max by (holder, opid) (pg_holder_max_xact_seconds{holder=~\"$holder\", usename!=\"observer\"}) > 0)", "legendFormat": "{{holder}}-{{opid}}"}],
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},

    {"type": "logs", "title": "Refused connections and full Odoo pools", "gridPos": {"x": 0, "y": 30, "w": 24, "h": 8},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "{service=~\".+_(odoo|website|odoo15|db)\"} |~ `too many clients|remaining connection slots|The Connection Pool Is Full`"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"type": "logs", "title": "Session recorder: every non-idle session each 30s, all sessions past 80% full", "gridPos": {"x": 0, "y": 38, "w": 24, "h": 12},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "{service=\"observer_recorder\"}"}],
     "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "sortOrder": "Descending"}},
    {"type": "logs", "title": "Connects and disconnects (disconnection lines carry the session length)", "gridPos": {"x": 0, "y": 50, "w": 24, "h": 8},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "{service=~\".+_db\"} |~ `connection authorized|disconnection:`"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}}
  ]
}
