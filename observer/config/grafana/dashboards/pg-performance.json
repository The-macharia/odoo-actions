{
  "uid": "pg-performance",
  "title": "Postgres performance",
  "tags": ["observer"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "links": [{"title": "Dashboards", "type": "dashboards", "tags": ["observer"], "asDropdown": true, "includeVars": true, "keepTime": true}],
  "templating": {"list": [
    {"name": "ds", "label": "Server", "type": "datasource", "query": "prometheus", "current": {"text": "__CLIENT__", "value": "prometheus"}},
    {"name": "logs", "label": "Logs", "type": "datasource", "query": "loki", "regex": "/^${ds:text} logs$/", "hide": 2},
    {"name": "db", "label": "Database", "type": "query", "datasource": {"type": "prometheus", "uid": "${ds}"},
     "query": {"query": "label_values(pg_database_size_bytes, datname)", "refId": "db"}, "definition": "label_values(pg_database_size_bytes, datname)",
     "regex": "/^(?!template|postgres$).*/", "refresh": 2, "current": {"text": "__DB__", "value": "__DB__"}}
  ]},
  "panels": [
    {"type": "stat", "title": "Database size", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "pg_database_size_bytes{datname=\"$db\"}"}],
     "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
     "options": {"colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Commits/s", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"$db\"}[5m]))"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 1}, "overrides": []},
     "options": {"colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Rollbacks", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"$db\"}[5m])) / (sum(rate(pg_stat_database_xact_commit{datname=\"$db\"}[5m])) + sum(rate(pg_stat_database_xact_rollback{datname=\"$db\"}[5m])))"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.05}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Cache hit", "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"$db\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"$db\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"$db\"}[5m])))"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1,
       "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.9}, {"color": "green", "value": 0.98}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Temp files written (range)", "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(increase(pg_stat_database_temp_bytes{datname=\"$db\"}[$__range]))", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
     "options": {"colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Wraparound age", "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "max(pg_wraparound_xid_age)"}],
     "fieldConfig": {"defaults": {"unit": "short",
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1000000000}, {"color": "red", "value": 1500000000}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"type": "table", "title": "Top statements by total time over the range (pg_stat_statements)", "gridPos": {"x": 0, "y": 4, "w": 24, "h": 10},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [
       {"refId": "A", "instant": true, "format": "table",
        "expr": "topk(20, sum by (queryid) (increase(pg_stat_statements_seconds_total{datname=\"$db\"}[$__range]))) * on (queryid) group_left (query) max by (queryid, query) (pg_stat_statements_query_id)"},
       {"refId": "B", "instant": true, "format": "table",
        "expr": "sum by (queryid) (increase(pg_stat_statements_calls_total{datname=\"$db\"}[$__range])) and on (queryid) topk(20, sum by (queryid) (increase(pg_stat_statements_seconds_total{datname=\"$db\"}[$__range])))"},
       {"refId": "C", "instant": true, "format": "table",
        "expr": "sum by (queryid) (increase(pg_stat_statements_rows_total{datname=\"$db\"}[$__range])) and on (queryid) topk(20, sum by (queryid) (increase(pg_stat_statements_seconds_total{datname=\"$db\"}[$__range])))"}],
     "transformations": [
       {"id": "merge", "options": {}},
       {"id": "calculateField", "options": {"mode": "binary", "alias": "mean", "binary": {"left": "Value #A", "operator": "/", "right": "Value #B"}, "replaceFields": false}},
       {"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {"query": 0, "Value #A": 1, "Value #B": 2, "mean": 3, "Value #C": 4, "queryid": 5},
         "renameByName": {"Value #A": "total time", "Value #B": "calls", "Value #C": "rows"}}},
       {"id": "sortBy", "options": {"sort": [{"field": "total time", "desc": true}]}}],
     "fieldConfig": {"defaults": {}, "overrides": [
       {"matcher": {"id": "byName", "options": "total time"}, "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 1}]},
       {"matcher": {"id": "byName", "options": "mean"}, "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 3}]},
       {"matcher": {"id": "byName", "options": "calls"}, "properties": [{"id": "decimals", "value": 0}]},
       {"matcher": {"id": "byName", "options": "rows"}, "properties": [{"id": "decimals", "value": 0}]},
       {"matcher": {"id": "byName", "options": "query"}, "properties": [{"id": "custom.width", "value": 900}]}]},
     "options": {"showHeader": true, "footer": {"show": false}}},
    {"type": "timeseries", "title": "Statement time by queryid (top 10)", "gridPos": {"x": 0, "y": 14, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "topk(10, sum by (queryid) (rate(pg_stat_statements_seconds_total{datname=\"$db\"}[$__rate_interval])))", "legendFormat": "{{queryid}}"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 30, "axisLabel": "busy (1 = one core)"}}, "overrides": []}},

    {"type": "timeseries", "title": "Transactions/s", "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"$db\"}[$__rate_interval]))", "legendFormat": "commit"},
                 {"refId": "B", "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"$db\"}[$__rate_interval]))", "legendFormat": "rollback"}],
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"type": "timeseries", "title": "Rows/s", "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_tup_fetched{datname=\"$db\"}[$__rate_interval]))", "legendFormat": "fetched"},
                 {"refId": "B", "expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"$db\"}[$__rate_interval]))", "legendFormat": "inserted"},
                 {"refId": "C", "expr": "sum(rate(pg_stat_database_tup_updated{datname=\"$db\"}[$__rate_interval]))", "legendFormat": "updated"},
                 {"refId": "D", "expr": "sum(rate(pg_stat_database_tup_deleted{datname=\"$db\"}[$__rate_interval]))", "legendFormat": "deleted"}],
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"type": "timeseries", "title": "Cache hit ratio", "gridPos": {"x": 0, "y": 30, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"$db\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{datname=\"$db\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=\"$db\"}[$__rate_interval])))", "legendFormat": "hit"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1}, "overrides": []}},
    {"type": "timeseries", "title": "Temp files written/s", "gridPos": {"x": 12, "y": 30, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(rate(pg_stat_database_temp_bytes{datname=\"$db\"}[$__rate_interval]))", "legendFormat": "temp"}],
     "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}},

    {"type": "table", "title": "Largest tables", "gridPos": {"x": 0, "y": 38, "w": 12, "h": 10},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [
       {"refId": "A", "expr": "pg_table_total_bytes", "instant": true, "format": "table"},
       {"refId": "B", "expr": "pg_table_index_bytes", "instant": true, "format": "table"},
       {"refId": "C", "expr": "pg_table_n_live_tup", "instant": true, "format": "table"},
       {"refId": "D", "expr": "pg_table_n_dead_tup", "instant": true, "format": "table"}],
     "transformations": [
       {"id": "merge", "options": {}},
       {"id": "filterFieldsByName", "options": {"include": {"names": ["relname", "Value #A", "Value #B", "Value #C", "Value #D"]}}},
       {"id": "organize", "options": {"renameByName": {"relname": "table", "Value #A": "total", "Value #B": "indexes", "Value #C": "live rows", "Value #D": "dead rows"}}},
       {"id": "sortBy", "options": {"sort": [{"field": "total", "desc": true}]}}],
     "fieldConfig": {"defaults": {"decimals": 0}, "overrides": [
       {"matcher": {"id": "byRegexp", "options": "total|indexes"}, "properties": [{"id": "unit", "value": "bytes"}]}]},
     "options": {"showHeader": true, "footer": {"show": false}}},
    {"type": "timeseries", "title": "Database size", "gridPos": {"x": 12, "y": 38, "w": 12, "h": 10},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "pg_database_size_bytes{datname!~\"template.*|postgres\"}", "legendFormat": "{{datname}}"}],
     "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},

    {"type": "logs", "title": "Statements slower than 2s (app= names the Odoo process)", "gridPos": {"x": 0, "y": 48, "w": 24, "h": 12},
     "datasource": {"type": "loki", "uid": "${logs}"},
     "targets": [{"refId": "A", "expr": "{service=~\".+_db\"} |= `duration:`"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}}
  ]
}
