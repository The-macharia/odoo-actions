{
  "uid": "server",
  "title": "Server",
  "tags": ["observer"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "links": [{"title": "Dashboards", "type": "dashboards", "tags": ["observer"], "asDropdown": true, "includeVars": true, "keepTime": true}],
  "templating": {"list": [
    {"name": "ds", "label": "Server", "type": "datasource", "query": "prometheus", "current": {"text": "__CLIENT__", "value": "prometheus"}}
  ]},
  "panels": [
    {"type": "stat", "title": "Odoo", "gridPos": {"x": 0, "y": 0, "w": 3, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "min(probe_success{job=\"odoo\"})"}],
     "fieldConfig": {"defaults": {
       "mappings": [{"type": "value", "options": {"0": {"text": "Down", "color": "red"}, "1": {"text": "Up", "color": "green"}}}],
       "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Odoo response", "gridPos": {"x": 3, "y": 0, "w": 3, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "max(probe_duration_seconds{job=\"odoo\"})"}],
     "fieldConfig": {"defaults": {"unit": "s", "decimals": 2,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 2}, {"color": "red", "value": 5}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "CPU", "gridPos": {"x": 6, "y": 0, "w": 3, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "observer:cpu:ratio"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.85}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Memory", "gridPos": {"x": 9, "y": 0, "w": 3, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "observer:memory:ratio"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Disk", "gridPos": {"x": 12, "y": 0, "w": 3, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "observer:disk:ratio"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.75}, {"color": "red", "value": 0.85}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Postgres connections", "gridPos": {"x": 15, "y": 0, "w": 3, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "observer:pg_connections:ratio"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0,
       "links": [{"title": "Postgres connections", "url": "/d/pg-connections?${__url_time_range}&var-ds=${ds}"}],
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Last backup", "gridPos": {"x": 18, "y": 0, "w": 3, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "time() - max(odoo_backup_last_success_timestamp_seconds)"}],
     "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "noValue": "never",
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 93600}]}}, "overrides": []},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "stat", "title": "Uptime", "gridPos": {"x": 21, "y": 0, "w": 3, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "max(node_time_seconds - node_boot_time_seconds)"}],
     "fieldConfig": {"defaults": {"unit": "s", "decimals": 0}, "overrides": []},
     "options": {"colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"type": "table", "title": "Firing alerts", "gridPos": {"x": 0, "y": 4, "w": 24, "h": 5},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "ALERTS{alertstate=\"firing\", severity!=\"none\"}", "instant": true, "format": "table"}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true, "alertstate": true}}}],
     "fieldConfig": {"defaults": {}, "overrides": []},
     "options": {"showHeader": true, "footer": {"show": false}}},

    {"type": "timeseries", "title": "CPU busy", "gridPos": {"x": 0, "y": 9, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))", "legendFormat": "busy"},
                 {"refId": "B", "expr": "avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[$__rate_interval]))", "legendFormat": "iowait"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}},
    {"type": "timeseries", "title": "Memory", "gridPos": {"x": 12, "y": 9, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes)", "legendFormat": "used"},
                 {"refId": "B", "expr": "sum(node_memory_MemTotal_bytes)", "legendFormat": "total"},
                 {"refId": "C", "expr": "sum(node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes)", "legendFormat": "swap used"}],
     "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}},

    {"type": "timeseries", "title": "CPU per service", "gridPos": {"x": 0, "y": 17, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum by (service) (label_replace(rate(container_cpu_usage_seconds_total{container_label_com_docker_swarm_service_name!=\"\"}[$__rate_interval]), \"service\", \"$1\", \"container_label_com_docker_swarm_service_name\", \"(.+)\"))", "legendFormat": "{{service}}"}],
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"axisLabel": "cores"}}, "overrides": []}},
    {"type": "timeseries", "title": "Memory per service", "gridPos": {"x": 12, "y": 17, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum by (service) (label_replace(container_memory_working_set_bytes{container_label_com_docker_swarm_service_name!=\"\"}, \"service\", \"$1\", \"container_label_com_docker_swarm_service_name\", \"(.+)\"))", "legendFormat": "{{service}}"}],
     "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},

    {"type": "timeseries", "title": "Disk used", "gridPos": {"x": 0, "y": 25, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|nsfs|fuse.*\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|nsfs|fuse.*\"}", "legendFormat": "{{mountpoint}}"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}},
    {"type": "timeseries", "title": "Disk I/O", "gridPos": {"x": 8, "y": 25, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(rate(node_disk_read_bytes_total[$__rate_interval]))", "legendFormat": "read"},
                 {"refId": "B", "expr": "sum(rate(node_disk_written_bytes_total[$__rate_interval]))", "legendFormat": "written"}],
     "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}},
    {"type": "timeseries", "title": "Network per service", "gridPos": {"x": 16, "y": 25, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum by (service) (label_replace(rate(container_network_transmit_bytes_total{container_label_com_docker_swarm_service_name!=\"\"}[$__rate_interval]), \"service\", \"$1\", \"container_label_com_docker_swarm_service_name\", \"(.+)\"))", "legendFormat": "{{service}} out"}],
     "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}},

    {"type": "timeseries", "title": "Containers per service (restarts show as steps)", "gridPos": {"x": 0, "y": 33, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "count by (service) (count by (service, name) (label_replace(max_over_time(container_start_time_seconds{container_label_com_docker_swarm_service_name!=\"\"}[15m]), \"service\", \"$1\", \"container_label_com_docker_swarm_service_name\", \"(.+)\")))", "legendFormat": "{{service}}"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []}},
    {"type": "timeseries", "title": "Out-of-memory kills", "gridPos": {"x": 12, "y": 33, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "targets": [{"refId": "A", "expr": "sum(increase(node_vmstat_oom_kill[$__rate_interval]))", "legendFormat": "kills"}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "custom": {"drawStyle": "bars"}}, "overrides": []}}
  ]
}
