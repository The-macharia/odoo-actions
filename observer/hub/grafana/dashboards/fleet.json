{
  "uid": "fleet",
  "title": "Fleet",
  "description": "One row per server. Reachable is the hub's heartbeat pull; Outside is Odoo checked from the hub over the public internet.",
  "tags": ["observer"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "schemaVersion": 39,
  "links": [{"title": "Dashboards", "type": "dashboards", "tags": ["observer"], "asDropdown": true, "keepTime": true}],
  "templating": {"list": []},
  "panels": [
    {"type": "table", "title": "Servers (click a name for its dashboards)", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 12},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "instant": true, "format": "table", "expr": "max by (client) (up{job=\"fleet\"}) or label_replace(vector(1), \"client\", \"__CLIENT__\", \"\", \"\")"},
       {"refId": "B", "instant": true, "format": "table", "expr": "max by (client) (label_replace(observer:odoo:up, \"client\", \"__CLIENT__\", \"client\", \"\"))"},
       {"refId": "C", "instant": true, "format": "table", "expr": "min by (client) (probe_success{job=\"fleet-odoo\"})"},
       {"refId": "D", "instant": true, "format": "table", "expr": "max by (client) (label_replace(observer:pg_connections:ratio, \"client\", \"__CLIENT__\", \"client\", \"\"))"},
       {"refId": "E", "instant": true, "format": "table", "expr": "max by (client) (label_replace(observer:cpu:ratio, \"client\", \"__CLIENT__\", \"client\", \"\"))"},
       {"refId": "F", "instant": true, "format": "table", "expr": "max by (client) (label_replace(observer:memory:ratio, \"client\", \"__CLIENT__\", \"client\", \"\"))"},
       {"refId": "G", "instant": true, "format": "table", "expr": "max by (client) (label_replace(observer:disk:ratio, \"client\", \"__CLIENT__\", \"client\", \"\"))"},
       {"refId": "H", "instant": true, "format": "table", "expr": "count by (client) (label_replace(ALERTS{alertstate=\"firing\", severity!=\"none\"}, \"client\", \"__CLIENT__\", \"client\", \"\"))"},
       {"refId": "I", "instant": true, "format": "table", "expr": "min by (client) ((probe_ssl_earliest_cert_expiry{job=\"fleet-odoo\"} - time()) / 86400)"}],
     "transformations": [
       {"id": "merge", "options": {}},
       {"id": "organize", "options": {"excludeByName": {"Time": true},
         "indexByName": {"client": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #D": 4, "Value #E": 5, "Value #F": 6, "Value #G": 7, "Value #H": 8, "Value #I": 9},
         "renameByName": {"client": "server", "Value #A": "reachable", "Value #B": "odoo", "Value #C": "outside", "Value #D": "pg connections",
           "Value #E": "cpu", "Value #F": "memory", "Value #G": "disk", "Value #H": "firing alerts", "Value #I": "cert days"}}},
       {"id": "sortBy", "options": {"sort": [{"field": "server"}]}}],
     "fieldConfig": {"defaults": {"custom": {"cellOptions": {"type": "color-text"}}}, "overrides": [
       {"matcher": {"id": "byName", "options": "server"}, "properties": [{"id": "links", "value": [
         {"title": "Server dashboard", "url": "/d/server?var-ds=${__value.raw}"},
         {"title": "Postgres connections", "url": "/d/pg-connections?var-ds=${__value.raw}"}]}]},
       {"matcher": {"id": "byRegexp", "options": "reachable|odoo|outside"}, "properties": [
         {"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "up", "color": "green"}}}]},
         {"id": "custom.cellOptions", "value": {"type": "color-background"}}]},
       {"matcher": {"id": "byRegexp", "options": "pg connections|cpu|memory|disk"}, "properties": [
         {"id": "unit", "value": "percentunit"}, {"id": "decimals", "value": 0},
         {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}]},
       {"matcher": {"id": "byName", "options": "firing alerts"}, "properties": [
         {"id": "noValue", "value": "0"}, {"id": "decimals", "value": 0},
         {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}]},
       {"matcher": {"id": "byName", "options": "cert days"}, "properties": [
         {"id": "decimals", "value": 0},
         {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 3}, {"color": "green", "value": 14}]}}]}]},
     "options": {"showHeader": true, "footer": {"show": false}}},

    {"type": "table", "title": "Firing alerts across the fleet", "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "instant": true, "format": "table",
       "expr": "label_replace(ALERTS{alertstate=\"firing\", severity!=\"none\"}, \"client\", \"__CLIENT__\", \"client\", \"\")"}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true, "alertstate": true}}}],
     "fieldConfig": {"defaults": {}, "overrides": []},
     "options": {"showHeader": true, "footer": {"show": false}}},

    {"type": "timeseries", "title": "Postgres connections used", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{client}}", "expr": "label_replace(observer:pg_connections:ratio, \"client\", \"__CLIENT__\", \"client\", \"\")"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}},
    {"type": "timeseries", "title": "Memory used", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{client}}", "expr": "label_replace(observer:memory:ratio, \"client\", \"__CLIENT__\", \"client\", \"\")"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}}
  ]
}
